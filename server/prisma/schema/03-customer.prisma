// ============================================================
// 03-customer.prisma — 客户与供应商领域：线索 / 客户 / 渠道 / 供应商
// Batch 5 物理拆分：内容逐字搬迁自原 server/prisma/schema.prisma，未做任何业务改动。
// ============================================================
// ========== 客户表（03 §2 · 客户主数据） ==========
// 剥离旧版销售属性：estimatedAmount 移出至 Opportunity（Batch 3）；images → coverImage + Attachment；
// customerLevel / intentLevel / source 枚举化；tags 数组化；firstOrderDate 类型化。
model Customer {
  id         String @id @default(cuid())
  customerNo String @unique // 旧列 customerCode → customerNo（RENAME COLUMN，见 05 §13.6）；CUS-yyyyMMdd-0001

  // ---- 基本信息 ----
  companyName String
  englishName String?
  industry    String? // 所属行业（非必填）
  website     String? // 公司官网（非必填）
  contactName String?
  position    String?
  email       String?
  phone       String?
  wechat      String?
  country     String?
  region      String?

  // ---- 获客来源（照搬线索渠道·平台组合，F-CRM-CHANNEL）----
  // 与 Lead.channelId / Lead.shopId 同义；线索转客户时原样带入，不另设 source 枚举语义。
  channelId String? // 来源渠道
  channel   Channel? @relation("CustomerChannel", fields: [channelId], references: [id], onDelete: SetNull)
  shopId    String? // 来源平台
  shop      Channel? @relation("CustomerShop", fields: [shopId], references: [id], onDelete: SetNull)

  // ---- 联系方式（与 Lead.contactMethods 一致：[{tool, account}] 数组，替代单字段 phone/email/wechat 的扁平录入）----
  contactMethods Json? // 沟通工具 + 账号（数组：[{tool, account}]）

  // ---- 分类与标记 ----
  customerLevel CustomerLevel @default(NORMAL)
  customerType  String? // 存 CustomerType.name（有意不建外键，见 02 §9）
  source        LeadSource?
  tags          String[]      @default([]) // 旧版为逗号分隔字符串 → PG 原生数组
  isKeyAccount  Boolean       @default(false)
  intentLevel   IntentLevel?
  notes         String?

  // ---- 归属（null = 公海）----
  ownerId String?
  owner   User?   @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // ---- 派生统计（由履约层回写，只读）----
  firstOrderAt        DateTime? // 旧列 firstOrderDate(String) → DateTime
  lastOrderAt         DateTime?
  totalOrderAmountCny Decimal?  @default(0) @db.Decimal(18, 4)

  // ---- 主图（其余图片走 Attachment(ownerType=CUSTOMER)）----
  coverImage String?

  // ---- 关联 ----
  customerProducts CustomerProduct[]
  prices           ProductPrice[]

  // ---- 销售 / 履约反向关系（Batch 3）----
  // 注意：不声明 profits Profit[]（Profit 不持有 customerId，客户维度利润经 salesOrder.customerId 派生，避免冗余不一致）。
  leads         Lead[]
  opportunities Opportunity[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  sampleOrders  SampleOrder[] // SampleOrder.customerId 的反向（04 §2）
  shipments     Shipment[] // Shipment.customerId 的反向（04 §6）
  payments      Payment[] // Payment.customerId 的反向（辅助主体，非宿主，04 §8）

  status MasterStatus @default(ACTIVE)
  // 注：原 `draft`（草稿客户）列已删除（V1.2）—— 暂存线索不再创建客户，
  //     客户信息只存在线索快照（`Lead.customerSnapshot` / `Lead.draftCustomerName`），
  //     只有建档时才在此表创建正式客户。见 prisma/scripts/migrate-draft-customers.ts。
  createdBy String?
  createdAt DateTime     @default(now())
  updatedBy String?
  updatedAt DateTime     @updatedAt
  deletedAt DateTime? // 软删除白名单（Q9）

  @@index([ownerId])
  @@index([companyName])
  @@index([country])
  @@index([channelId])
  @@index([shopId])
  @@index([status])
  @@index([customerLevel])
}

// ========== 供应商（02 §7 · 主数据扩展） ==========
model Supplier {
  id         String   @id @default(cuid())
  supplierNo String   @unique // SUP-yyyyMMdd-0001（新增，无旧字段来源）
  name       String // 供应商名称
  shortName  String? // 简称，用于生产单短标签
  contact    String? // 联系人
  phone      String? // 联系电话
  email      String?
  country    String?
  address    String? // 地址
  /// 新增：供应商能力标签（工艺 / 品类），用于采购选源
  crafts     String[] @default([]) // 存 ProductCraft.name
  categories String[] @default([]) // 存 ProductCategory.name

  paymentTerms String? // 账期
  rating       Int? // 1-5 星
  status       MasterStatus @default(ACTIVE)
  ownerId      String?
  remark       String?
  createdBy    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime? // 软删除白名单（Q9）

  purchaseOrders       PurchaseOrder[]
  productionOrderItems ProductionOrderItem[] // ProductionOrderItem.supplierId 的反向（Batch 3）

  @@index([status])
  @@index([name])
}

// ========== 线索产品明细（03 §3.1 · 旧 LeadProduct 改名 LeadItem）==========
// 05 §13.6：LeadProduct → LeadItem（RENAME TABLE）；列语义修正（旧 leadId 值实际指向 SalesPipeline → 重映射到真正 Lead，05 §3.5）。
model LeadItem {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// V1.1（20260930120000_lead_fk_only）：只存产品外键，产品主数据唯一权威在 Product。
  /// productName / craftIds / audienceId / categoryId / sizeL / sizeW / sizeH / weight 已下线：
  /// 产品名与分类规格一律经 product 关系读取，建档由后端在创建/更新线索时原子完成。
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// D2（F-8L）：**线索级**「客户具体要求」（材质 / 规格 / 工艺 / 用途等），非产品主数据副本。
  /// 严禁写入或反填 Product.description（两者语义严格分离，用户 2026-09-27 明确约定）。
  productDesc String?
  /// **产品需求快照**（V1.2，与客户快照同构）：
  ///   · **未建档**（`productId` 为空）→ 线索里填的产品需求（产品名 / 工艺 craftIds / 受众 audienceId /
  ///     品类 categoryId / 长宽高 / 克重 / 参考图片）**只存在这里**：暂存期**不创建产品库记录**；
  ///   · **建档**（关联 `productId`）→ 本字段改由 Product 档案刷新留痕，产品主数据唯一权威仍是 Product。
  /// 目标价位 / 客户期望交期属**线索级**字段（落在 Lead 上），不进本快照。
  productSnapshot Json?
  quantity    Int      @default(1) // 意向数量，保留 Int（04 §12#7）
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([productId])
}

// ============ 打样申请 / 报价单（Batch 3 已从旧通用 Order 拆出：SampleOrder / Quotation）============

// ============ 获客渠道 / 平台（自关联树） ============
// category 区分线上渠道(ONLINE)与线下渠道(OFFLINE)
// 树形：父节点为渠道（如 国际站 / 1688 / 线下渠道），子节点为平台（如 寿春平台 / 微它平台 / 景元平台）
model Channel {
  id        String       @id @default(cuid())
  name      String // 渠道名或平台名
  category  String       @default("ONLINE") // ONLINE | OFFLINE
  parentId  String? // 渠道下的平台才有父级
  parent    Channel?     @relation("ChannelTree", fields: [parentId], references: [id], onDelete: SetNull) // 删父渠道不连带删子平台
  children  Channel[]    @relation("ChannelTree")
  contact   String? // 平台联系人 / 负责人
  status    MasterStatus @default(ACTIVE) // 旧 status String("ENABLED") → 枚举
  sort      Int          @default(0)
  remark    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  leads     Lead[] @relation("LeadChannel")
  leadShops Lead[] @relation("LeadShop")
  customers     Customer[] @relation("CustomerChannel")
  customerShops Customer[] @relation("CustomerShop")
  // 商机来源渠道 / 平台的反向 relation（真实外键在 Opportunity 一侧：channelId / shopId）。
  // 两条字段名必须互异（opportunities / opportunityShops），与上方 customers / customerShops 同模式；
  // 缺失任一都会导致 Prisma schema 校验失败（P1012，Round R-1.1 修复项）。
  // 纯 schema 关系声明：不产生任何数据库列、约束或索引变更。
  opportunities    Opportunity[] @relation("OpportunityChannel")
  opportunityShops Opportunity[] @relation("OpportunityShop")

  @@unique([parentId, name]) // 同名平台不得重复创建
  @@index([category])
}

// ============ 客户类型（全局配置，用于线索/客户） ============
model CustomerType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String? // 类型说明
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sort])
  @@index([isActive])
}

// ============ 沟通工具（系统设置维护，线索/客户联系方式下拉取值）============
model CommunicationTool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String? // 工具说明
  icon        String? // 工具图标（antd 图标组件名，如 MailOutlined；详情/列表联系方式用 icon+值 展示）
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sort])
  @@index([isActive])
}

// ============ 线索（03 §3.1 · 重构）============
model Lead {
  id       String @id @default(cuid())
  leadNo   String @unique // XS-yyyyMM-0001（旧 leadNumber → RENAME COLUMN + 补号去重，05 §5）
  leadName String // 线索名称（国家+产品+数量）

  // ---------- 来源 ----------
  source    LeadSource @default(MANUAL)
  channelId String? // 来源渠道
  channel   Channel?   @relation("LeadChannel", fields: [channelId], references: [id], onDelete: SetNull)
  shopId    String? // 来源平台
  shop      Channel?   @relation("LeadShop", fields: [shopId], references: [id], onDelete: SetNull)

  // ---------- 客户（V1.1：只存外键，客户主数据唯一权威在 Customer）----------
  // 20260930120000_lead_fk_only 起，线索不再持有客户冗余列：
  // companyName / contactName / contactMethods / email / phone / country / customerType 已下线。
  // 新建 / 更新线索时由后端原子建档（归一名称匹配既有客户，命中复用否则新建）并回填 customerId；
  // 读取一律经 customer 关系，避免「同一信息两处权威」。
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ---------- 客户快照（暂存期承载客户草稿；未确认期间随线索更新刷新，确认后冻结）----------
  /// 客户信息的留痕快照，**暂存期即客户信息的唯一载体**。
  /// 规则：
  ///   · **暂存**（`customerLocked = false` 且未关联客户）：不创建 Customer 行，
  ///     客户信息（公司名 / 联系人 / 联系方式 / 邮箱 / 电话 / 国家地区 / 客户类型 / 来源）
  ///     全部存在本快照里 —— 暂存客户**不进客户库**；
  ///   · 客户建档（`customerLocked` 置 true）时才创建正式 Customer 并绑定 `customerId`，
  ///     随后快照改由客户档案刷新（内含 customerId / customerNo / 渠道平台名称）；
  ///   · 线索**未确认**（status = NEW）期间，**每次线索更新都会同步刷新**；
  ///   · 线索**确认**（NEW → CONFIRMED）时固化最后一版，此后**冻结、不再改动**；
  ///   · 单纯修改客户档案（不更新线索）不会刷新快照 —— 快照跟随线索更新节奏；
  ///   · 不可由接口修改：不在 `LEAD_WRITABLE_FIELDS` / 不在请求 schema 中。
  customerSnapshot   Json?
  /// 快照写入时点
  customerSnapshotAt DateTime?
  /// **暂存客户名匹配键**（仅暂存期有值，建档 / 关联既有客户后清空）。
  /// 取值 = 归一化（trim + 小写）后的公司名，用于「**暂存即阻塞**」的跨线索占用检查：
  /// 他人已暂存同名 → 拒绝，避免两条线索各自暂存同一客户名、建档时才发现冲突。
  /// **公海（无负责人）不占名**：释放到公海即清空本列（公海支持认领、不支持暂存），
  /// 认领成为负责人后若该名称仍空闲则重新登记；入住公海期间资料仍留在 `customerSnapshot`。
  draftCustomerName String?

  // ---------- 需求（结构化，替代旧版 10 个平铺扩展字段中的同类项）----------
  productInterest String?
  targetPrice     String?
  /// 建档美元汇率快照：**1 USD = usdRate CNY**，于线索建档（createLead）时抓取当日
  /// DailyExchangeRate 中 USD 的 rateToCny 并落库，与线索自身币种无关，固定为美元汇率。
  /// 仅建档时写入一次，后续编辑（updateLead）不再变更，用于记录建档时点美元汇率。
  usdRate         Decimal? @db.Decimal(18, 8)
  targetMarket    String?
  currency        String? // 币种（Currency.code），目标价位前缀，默认 CNY
  unit            String? // 单位（Unit.name），数量需求后缀，默认 个
  expectedDelivery DateTime? // 客户期望交期
  remark          String?

  // ---------- 状态机 ----------
  status LeadStatus @default(NEW)
  /// 三步向导当前阶段（0 客户信息 / 1 需求详情 / 2 确认商机）：
  /// 暂存/保存时由前端写入，详情面板据此决定底部按钮展示「编辑」或「确认」。
  /// 旧数据为 null（视为已到确认阶段）；转商机后该字段不再有意义。
  stage Int?
  /// 草稿标记：暂存=1（仅落线索表，未建档）；建档/锁定/正式提交=0。
  /// 详情接口返回，前端据此区分「草稿（可编辑、显示暂存）」与「已正式建档（锁定）」。
  draft Boolean @default(false)
  /// 阶段锁定标志：客户信息（建档后锁定）/ 需求详情（建档后锁定）是否锁定。
  /// 随暂存 / 建档 / 正式提交落库，详情打开时直接复现，避免仅依赖 draft 派生导致关掉后锁定状态丢失。
  customerLocked Boolean @default(false)
  productLocked  Boolean @default(false)

  // ---------- 转化（转商机后回填）----------
  convertedAt   DateTime?
  /// 反向关系：真实外键在 Opportunity 一侧（Opportunity.leadId，**非 unique**）。
  /// 基数 **Lead 1:N Opportunity**；此处**不得**再声明 opportunityId 冗余列（双向真实 FK 会产生循环外键与双写不一致）。
  opportunities Opportunity[] @relation("OpportunityLead")

  // ---------- 归属（null = 公海）----------
  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  items      LeadItem[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([customerId])
  @@index([channelId])
  @@index([source])
  @@index([createdAt])
  @@index([draftCustomerName])
}
