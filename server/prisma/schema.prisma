generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 用户表 ==========
model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  password            String
  realName            String
  email               String?              @unique
  phone               String?
  avatar              String?
  status              String               @default("ACTIVE")
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id])
  roleId              String?
  role                Role?                @relation(fields: [roleId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastLoginAt         DateTime?
  loginLogs           LoginLog[]
  createdBy           String?
  creator             User?                @relation("CreatedUsers", fields: [createdBy], references: [id])
  createdUsers        User[]               @relation("CreatedUsers")
  refreshTokens       String[]             @default([])
  salesPipelines      SalesPipeline[]
  customers           Customer[]
  productVisibilities ProductVisibleUser[]
  products            SingleProduct[]      @relation("ProductCreator")
  singleProductOwnerships SingleProduct[]  @relation("SingleProductOwner")
  productGroups       ComboProduct[]       @relation("ComboProductOwner")
  comboCreatedBy      ComboProduct[]       @relation("ComboProductCreator")
  leadAssignments     Lead[]               @relation("LeadAssignee")
  notifications       Notification[]       @relation("NotificationRecipient")
}

// ========== 通知表 ==========
// 通用通知中心：权限变更、审批、系统公告等均复用。在线用户经 SSE 实时推送，
// 离线用户落库，下次连接时由 /api/auth/events 拉取未读。多实例部署时只需把
// 推送环节改为 Redis pub/sub，写库与读取接口保持不变。
model Notification {
  id        String   @id @default(cuid())
  userId    String   // 接收人
  recipient User?    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      String   // PERM_CHANGED / APPROVAL / ANNOUNCE ...
  title     String
  body      String?
  payload   Json?    // 业务附加数据，如 { roleId } 供前端决定动作
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read])
}

// ========== 角色表 ==========
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  status      Int              @default(1)
  sort        Int              @default(0)
  // 数据范围：ALL 全部 | DEPT 本部门 | SELF 仅本人（默认）；公海/公开数据对集团开放，不占用档位
  dataScope   String           @default("SELF")
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ========== 权限表 ==========
model Permission {
  id        String           @id @default(uuid())
  name      String           @unique
  code      String           @unique
  type      String           @default("BUTTON")
  parentId  String?
  parent    Permission?      @relation("PermissionTree", fields: [parentId], references: [id])
  children  Permission[]     @relation("PermissionTree")
  roles     RolePermission[]
  sort      Int              @default(0)
  path      String?
  icon      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ========== 角色-权限关联表 ==========
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ========== 部门表 ==========
model Department {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  leader    String?
  phone     String?
  email     String?
  sort      Int          @default(0)
  status    Int          @default(1)
  users     User[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ========== 登录日志表 ==========
model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  loginAt   DateTime @default(now())
  success   Boolean  @default(true)
  message   String?
}

// ========== 操作日志表 ==========
model OperationLog {
  id        String   @id @default(uuid())
  userId    String
  username  String
  realName  String? // 操作人姓名（昵称）
  action    String
  module    String
  target    String?
  targetId  String?
  detail    String? // 人类可读摘要（如「创建了产品」）
  summary   String? // 同 detail，统一字段名
  diff      String? // 结构化变更 JSON：[{field,label,beforeText,afterText}]
  ip        String?
  createdAt DateTime @default(now())
}

// ========== 客户表 ==========
model Customer {
  id            String  @id @default(uuid())
  customerCode  String? @unique // 客户编号：CUS-YYMMDD-序号
  companyName   String
  contactName   String?
  englishName   String? // 英文名
  position      String? // 职位
  email         String?
  phone         String?
  wechat        String? // 微信
  country       String?
  region        String? // 所在地区（省市区，如 "广东省·广州市"）
  customerLevel String? @default("普通客户") // 客户等级：钻石客户/战略客户/优质客户/普通客户/潜在客户
  source        String? // MANUAL / EXCEL / XIAOMAN
  notes         String?

  // 归属（null = 公海）
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  // 重点客户标记
  isKeyAccount Boolean @default(false)
  intentLevel  String? // LOW / MEDIUM / HIGH / READY

  // 客户标签（逗号分隔，如 "VIP,长期合作,高利润"）
  tags String? @default("")

  // 首次下单日期（自动推算：取其下最早订单日期）
  firstOrderDate String?

  // 预计商机金额
  estimatedAmount Float?

  // 客户类型（与 CustomerType 配置保持一致，但不做外键，避免历史数据/停用类型问题）
  customerType String?

  // 关联数据
  orders     Order[]
  pipelines  SalesPipeline[]
  leads      Lead[]
  activities CustomerActivity[]
  payments   PaymentRecord[]
  profits    ProfitRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 客户活动日志 ==========
model CustomerActivity {
  id         String   @id @default(uuid())
  customerId String
  action     String // CLAIM / RELEASE / CREATED / UPDATED / KEY_TOGGLE / INTENT_CHANGE
  detail     String?
  summary    String?
  diff       String?
  realName   String?
  createdBy  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ========== 通用单据表（报价 / 打样 / 正式订单 / 生产单 / 出货单） ==========
// type: QUOTE(报价) / SAMPLE(打样) / ORDER(正式订单) / PRODUCTION(生产单) / SHIPPED(出货单)
// status: 审批态 DRAFT → SUBMITTED → APPROVED / REJECTED
// stage: 仅 SAMPLE 用（打样阶段）：DESIGN(设计) → MOLD(开模) → SAMPLE_SENT(寄样)
model Order {
  id          String   @id @default(uuid())
  type        String   @default("ORDER") // QUOTE / SAMPLE / ORDER / PRODUCTION / SHIPPED
  orderNo     String?
  title       String?
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // 来源（基于产品/组合创建）与商机绑定
  targetType  String?  // PRODUCT / GROUP
  targetId    String?
  pipelineId  String?  // 绑定的商机 ID（可选）

  // 审批态（报价/打样/订单通用）
  status      String   @default("DRAFT") // DRAFT / SUBMITTED / APPROVED / REJECTED
  // 打样阶段（仅 SAMPLE 使用）：DESIGN / MOLD / SAMPLE_SENT，其余类型留空
  stage       String?  @default("DESIGN") // DESIGN / MOLD / SAMPLE_SENT

  items       String?  // 单据明细 JSON：{productId,name,spec,quantity,unitPrice,amount,pipelineId?}[]
  amountCNY   Float?   // 单据金额合计（CNY）
  currency    String?  @default("CNY")

  // 仅正式订单使用
  orderDate     String?
  depositAmount Float?
  depositPaid   Boolean? @default(false)
  deliveryDate  String?
  paymentTerms  String?
  // 各阶段时间节点（用于进度跟踪，可选）
  sampleOrderDate     String?
  designDate          String?
  moldDate            String?
  sampleSentDate      String?
  productionStartDate String?
  shippedDate         String?

  remark    String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联：付款单 / 利润单（以本单为基准）
  payments  PaymentRecord[]
  profits   ProfitRecord[]

  @@index([type])
  @@index([customerId])
  @@index([status])
}

// ========== 供应商 ==========
model Supplier {
  id        String   @id @default(uuid())
  name      String   // 供应商名称
  contact   String?  // 联系人
  phone     String?  // 联系电话
  address   String?  // 地址
  remark    String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases PurchaseOrder[]
}

// ========== 采购单 ==========
// status: DRAFT(草稿) → ORDERED(已下单) → PARTIAL(部分到货) → ARRIVED(已到货)，可 CANCELLED(已取消)
model PurchaseOrder {
  id           String   @id @default(uuid())
  purchaseNo   String?  @unique // 采购单号 PO-xxxx
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseDate String?  // 采购日期
  status       String   @default("DRAFT") // DRAFT / ORDERED / PARTIAL / ARRIVED / CANCELLED
  items        String?  // 明细 JSON：{productId,name,spec,quantity,unitPrice,amount}[]
  amountCNY    Float?   // 明细合计金额（CNY）
  remark       String?
  ownerId      String?  // 负责人（采购员），数据范围归属
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([ownerId])
}

// ========== 付款单（收款记录） ==========
// 记录某单据的收款明细与比例，关联 Order
model PaymentRecord {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  paymentNo   String?  // 付款单号
  payDate     String?  // 收款日期
  amount      Float?   // 本次收款金额（CNY）
  ratio       Float?   // 收款比例（0-100，相对订单金额）
  method      String?  // 收款方式：电汇/信用证/支付宝...
  status      String   @default("RECEIVED") // RECEIVED / PENDING
  remark      String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
}

// ========== 利润单（利润核算） ==========
// 记录某单据的利润核算，关联 Order
model ProfitRecord {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  profitNo    String?  // 利润单号
  revenue     Float?   // 收入（CNY）
  cost        Float?   // 成本（CNY）
  profit      Float?   // 利润 = 收入 - 成本
  margin      Float?   // 利润率（%）
  currency    String?  @default("CNY")
  remark      String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
}

// ========== 审批配置表 ==========
// 用于「设置 → 审批管理」中配置各单据类型的审批人
model ApprovalConfig {
  id           String   @id @default(uuid())
  type         String   @unique // QUOTE / SAMPLE / ORDER / PRODUCTION / SHIPPED
  approverIds  String?  // 审批人用户 ID 数组 JSON
  approverNames String? // 审批人姓名冗余 JSON
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ========== 销售管道 ==========
model SalesPipeline {
  id             String  @id @default(uuid())
  pipelineNumber String? @unique // 商机编号：BO-YYYYMMDD-序号
  stage          String  @default("LEAD") // LEAD → OPPORTUNITY → ORDER

  // 关联客户
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // 来源线索（线索确认转商机时绑定，便于溯源）
  leadId String? // 普通字段：来源线索 ID，用于溯源与查询
  lead   Lead?   @relation("LeadPipeline") // 反向关系（外键在 Lead.pipelineId 一侧）

  // 基础信息（各阶段通用）
  title       String
  companyName String
  contactName String?
  email       String?
  phone       String?
  country     String?

  // 线索阶段
  source          String? // 来源: XIAOMAN / EXCEL / MANUAL
  productInterest String? // 感兴趣的产品
  leadNotes       String?

  // 商机阶段
  estimatedAmount    Float? // 预估金额(CNY)
  estimatedCloseDate String? // 预计成交日期
  probability        String? // 采购意向：准成交 / 高意向 / 中意向 / 低意向（直接存储文案，不再存数字）
  opportunityNotes   String?

  // 订单阶段
  orderAmount  Float? // 订单金额(CNY)
  orderDate    String? // 下单日期
  deliveryDate String? // 交付日期
  paymentTerms String? // 付款条件
  orderStatus  String? // 订单阶段已统一到 Order 模型（DEPOSIT/SAMPLE_ORDER/DESIGN/MOLD/SAMPLE_SENT/PRODUCTION/SHIPPED）
  orderNotes   String?

  // 样品单阶段信息（导入兼容）
  sampleType     String?
  sampleStatus   String?
  sampleQuantity Int?
  sampleNotes    String?

  // 系统字段
  assignedTo   String?
  assignee     User?           @relation(fields: [assignedTo], references: [id])
  activities   SalesActivity[]
  leadProducts LeadProduct[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ========== 报价 ==========
model Quotation {
  id              String   @id @default(uuid())
  opportunityId   String // 关联商机（SalesPipeline.id）
  customerId      String? // 关联客户
  productId       String? // 关联产品
  title           String // 报价标题
  version         Int      @default(1) // 版本号（同一商机可有多版报价）
  amount          Float // 报价金额
  currency        String   @default("USD")
  validUntil      DateTime? // 报价有效期
  status          String   @default("DRAFT") // DRAFT / SENT / ACCEPTED / REJECTED
  notes           String? // 备注
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([opportunityId])
  @@index([customerId])
}

// ========== 工艺 ==========
model ProductCraft {
  id        String          @id @default(uuid())
  name      String          @unique // 搪胶 / 注塑 / 硅胶（基础工艺，可多选组合）
  code      String?         @unique // 编码（如 TJ / ZS / GJ），用于自动生成 SKU
  sort      Int             @default(0)
  status    Int             @default(1) // 1 启用 / 0 停用
  products  SingleProduct[] // 多对多：一个单品可挂多个工艺
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// ========== 二级受众 ==========
model ProductAudience {
  id         String            @id @default(uuid())
  name       String            @unique // 儿童 / 宠物 / 配件 / 文具 / 家居
  code       String?           @unique // 编码（如 ET / CW / PJ / WJ / JJ），用于自动生成 SKU
  sort       Int               @default(0)
  status     Int               @default(1)
  categories ProductCategory[] // 关联三级品类
  products   SingleProduct[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

// ========== 三级产品品类 ==========
model ProductCategory {
  id         String          @id @default(uuid())
  name       String // 沐浴玩具 / 挤压玩具 / 存钱罐 ...
  audienceId String
  audience   ProductAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  sort       Int             @default(0)
  status     Int             @default(1)
  products   SingleProduct[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([audienceId, name])
}

// ========== 产品 ==========
// 定制类产品核心模型：工艺 → 受众 → 品类 三级分类 + 产品属性 + 产品要求
// ============ 单品表（原 Product 的主体；组合由单品构成）============
model SingleProduct {
  id   String  @id @default(cuid())
  name String
  sku  String? @unique

  // ---- 三级分类 ----
  crafts     ProductCraft[] // 多对多：工艺（可多选，如 搪胶+注塑）
  audienceId String?
  audience   ProductAudience? @relation(fields: [audienceId], references: [id])
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  // ---- (定制)产品属性（必填）----
  images String? // 产品图片 JSON 数组 [{url,name}]，第一张为主图
  sizeL  String? // 长 cm
  sizeW  String? // 宽 cm
  sizeH  String? // 高 cm
  weight String? // 克重 g

  // ---- (深/轻)产品要求（打样单号）----
  sampleNo    String? // 打样单号
  logo        Boolean @default(false) // 功能：logo
  sound       Boolean @default(false) // 发声
  glow        Boolean @default(false) // 发光
  colorChange Boolean @default(false) // 变色
  sprayWater  Boolean @default(false) // 喷水
  colors      String? // 颜色（潘通色），逗号分隔
  packaging   String? // 产品包装（卡/盒/袋/桶）

  // ---- 供货定制模式（多选，由角色决定可选范围）----
  supplyModes String? @default("") // 逗号分隔：DEEP_CUSTOM/LIGHT_CUSTOM/STOCK

  // ---- 认证资质：关联现有证书，逗号分隔证书 id ----
  certificationIds String? @default("") // 逗号分隔证书 id

  // ---- 产品进度（打样 / 报价 阶段多子任务并行）----
  progress String? @default("{}")

  // ---- 价格库存 ----
  description   String?
  price         Float?
  currency      String? @default("CNY")
  taxRate       Float?  @default(13)
  stock         Int?    @default(0)
  lowStockAlert Int?    @default(0)
  source        String  @default("MANUAL")
  // 单品可见性：PUBLIC 所有人可见；PRIVATE 仅指定用户可见
  visibility    String  @default("PUBLIC")
  remark        String?

  visibleUsers ProductVisibleUser[]
  groupItems   ComboItem[] // 作为单品被哪些组合引用
  leadProducts LeadProduct[]
  leads        Lead[] // 作为采购产品被哪些线索引用
  activities   ProductActivity[] // 产品操作记录（时间线）
  createdBy    String? // 创建人 id
  creator      User?                @relation("ProductCreator", fields: [createdBy], references: [id])
  // 负责人（指定人，转交线索时联动更新）
  ownerId      String?
  owner        User?                @relation("SingleProductOwner", fields: [ownerId], references: [id])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// 产品可见人关联：visibility=PRIVATE 时，仅 listed 用户可见该单品
model ProductVisibleUser {
  id        String        @id @default(cuid())
  productId String
  product   SingleProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([productId, userId])
  @@index([userId])
}

// 线索-产品关联（一条线索可包含多个单品，带数量）
model LeadProduct {
  id        String        @id @default(cuid())
  leadId    String
  productId String
  quantity  Int           @default(1)
  pipeline  SalesPipeline @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product   SingleProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([leadId, productId])
}

// ========== 产品操作记录 ==========
model ProductActivity {
  id        String         @id @default(cuid())
  // 关联对象：单品或组合（二选一）
  productId String? // 单品 id
  product   SingleProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
  comboId   String? // 组合 id
  combo     ComboProduct?  @relation(fields: [comboId], references: [id], onDelete: Cascade)
  // 操作类型：CREATE / UPDATE / DELETE / STAGE / STATUS 等
  action    String
  // 操作详情（JSON 字符串，记录前后变化或备注）
  detail    String?
  // 摘要（人类可读的「做了什么」）
  summary   String?
  // 结构化变更 JSON：[{field,label,beforeText,afterText}]
  diff      String?
  // 操作人（冗余存储姓名，便于展示）
  operator  String?
  realName  String? // 操作人姓名（昵称），与 operator 区分：realName 优先展示
  createdBy String?
  createdAt DateTime       @default(now())

  @@index([productId])
  @@index([comboId])
}

// ========== 销售活动日志 ==========
model SalesActivity {
  id         String   @id @default(uuid())
  pipelineId String
  action     String // STAGE_CHANGE / NOTE_ADDED / CREATED / UPDATED
  fromStage  String?
  toStage    String?
  comment    String?
  createdBy  String
  createdAt  DateTime @default(now())

  pipeline SalesPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

// ========== 每日汇率表 ==========
model DailyExchangeRate {
  id           String   @id @default(uuid())
  date         String // "YYYY-MM-DD"
  currencyCode String // USD, EUR, GBP, JPY, etc.
  ratePerCNY   Float // 1 CNY = 目标币种汇率
  createdAt    DateTime @default(now())

  @@unique([date, currencyCode], name: "daily_rate_unique")
}

// ========== 证书管理 ==========
model Certificate {
  id         String    @id @default(cuid())
  name       String // 证书名称，如 CE 认证
  code       String? // 证书编号 / 标准代号，如 CE / FCC
  issuer     String? // 发证机构
  category   String? // 分类，如 安全 / 电磁兼容 / 环保
  validUntil DateTime? // 有效期至（可选）
  status     Int       @default(1) // 1 启用 0 停用
  logo       String? // 证书 Logo 图片 URL
  remark     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ============ 组合（由多个单品构成，用于批量报价 / 打样 / 集合管理）============
model ComboProduct {
  id          String            @id @default(cuid())
  name        String // 组合名称
  sku         String?           @unique
  description String? // 备注
  ownerId     String // 创建人
  owner       User              @relation("ComboProductOwner", fields: [ownerId], references: [id])
  status      Int               @default(1) // 1 启用 0 停用
  remark      String?
  items       ComboItem[] // 组合明细
  activities  ProductActivity[] // 组合操作记录（时间线）
  createdBy   String?
  creator     User?             @relation("ComboProductCreator", fields: [createdBy], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// 组合明细：一个组合包含多个单品，每行含规格/数量/单价
model ComboItem {
  id        String         @id @default(cuid())
  groupId   String
  group     ComboProduct   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  productId String? // 关联已有单品；行内快速新建单品时为空，新建后回填
  product   SingleProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  price     Float? // 单品单价
  sort      Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([groupId])
  @@index([productId])
}

// ============ 打样申请 / 报价单 已并入通用 Order（type = SAMPLE / QUOTE） ============

// ============ 获客渠道 / 平台（自关联树） ============
// category 区分线上渠道(ONLINE)与线下渠道(OFFLINE)
// 树形：父节点为渠道（如 国际站 / 1688 / 线下渠道），子节点为平台（如 寿春平台 / 微它平台 / 景元平台）
model Channel {
  id         String   @id @default(cuid())
  name       String // 渠道名或平台名
  category   String   @default("ONLINE") // ONLINE | OFFLINE
  parentId   String? // 渠道下的平台才有父级
  parent     Channel? @relation("ChannelTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Channel[] @relation("ChannelTree")
  contact    String? // 平台联系人 / 负责人
  status     String   @default("ENABLED") // ENABLED | DISABLED
  sort       Int      @default(0)
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leadChannels Lead[] @relation("LeadChannel")
  leadShops    Lead[] @relation("LeadShop")

  @@index([parentId])
  @@index([category])
}

// ============ 客户类型（全局配置，用于线索/客户） ============
model CustomerType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String? // 类型说明
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sort])
  @@index([isActive])
}

// ============ 线索 ============
// 线索主要字段由「客户信息」+「线索名称」构成
model Lead {
  id           String   @id @default(cuid())
  leadNumber   String? // 线索号：XS-YYYYMM-序号
  leadName     String // 线索名称（标题）
  customerId   String? // 关联客户
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pipelineId   String? @unique // 关联商机（确认转商机后回填，便于溯源）
  pipeline     SalesPipeline? @relation("LeadPipeline", fields: [pipelineId], references: [id], onDelete: SetNull)
  channelId    String? // 来源渠道
  channel      Channel? @relation("LeadChannel", fields: [channelId], references: [id], onDelete: SetNull)
  shopId       String? // 来源平台
  shop         Channel? @relation("LeadShop", fields: [shopId], references: [id], onDelete: SetNull)
  source       String   @default("MANUAL") // MANUAL | EXCEL | RPA | SYNC
  status       String   @default("NEW") // NEW | CONTACTED | QUALIFIED | INVALID | CONVERTED | VALID
  companyName  String? // 未关联客户时直接记录的客户信息
  contactName  String?
  contactMethod String? // 沟通方式：微信号/旺旺名/邮箱/whatsapp 等添加客户的方式
  email        String?
  phone        String?
  country      String?
  productInterest String? // 感兴趣产品
  sourceChannel String? // 来源渠道/平台（存渠道名或「渠道 / 平台」完整路径）
  productName String? // 未关联产品时直接记录的产品名称（待确认建档）
  productId  String? // 采购产品
  product    SingleProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity   Int            @default(1) // 采购数量
  remark       String?
  // 详情扩展字段（左右结构详情视图）
  targetMarket String? // 目标市场
  productType  String? // 产品类型
  productDesc  String? // 产品描述
  images       String? // 参考图片（JSON 数组：["url1","url2"]）
  targetPrice  String? // 目标价位
  certRequire  String? // 认证要求
  packageReq   String? // 包装要求
  deliveryReq  String? // 交期要求
  specialReq   String? // 特殊要求
  customerType String? // 客户类型
  assignedTo   String? // 负责人 userId
  assignedUser User?   @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  createdBy    String? // 创建人 userId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([channelId])
  @@index([shopId])
  @@index([productId])
  @@index([status])
  @@index([source])
}
