generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========== 用户表 ==========
model User {
  id          String       @id @default(uuid())
  username    String       @unique
  password    String
  realName    String
  email       String?      @unique
  phone       String?
  avatar      String?
  status      String       @default("ACTIVE")
  departmentId String?
  department  Department?  @relation(fields: [departmentId], references: [id])
  roleId      String?
  role        Role?        @relation(fields: [roleId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastLoginAt DateTime?
  loginLogs   LoginLog[]
  createdBy   String?
  creator     User?        @relation("CreatedUsers", fields: [createdBy], references: [id])
  createdUsers User[]      @relation("CreatedUsers")
  refreshToken String?
  salesPipelines SalesPipeline[]
  customers      Customer[]
}



// ========== 角色表 ==========
model Role {
  id          String      @id @default(uuid())
  name        String      @unique
  code        String      @unique
  description String?
  status      Int         @default(1)
  sort        Int         @default(0)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ========== 权限表 ==========
model Permission {
  id       String           @id @default(uuid())
  name     String           @unique
  code     String           @unique
  type     String           @default("BUTTON")
  parentId String?
  parent   Permission?      @relation("PermissionTree", fields: [parentId], references: [id])
  children Permission[]     @relation("PermissionTree")
  roles    RolePermission[]
  sort     Int              @default(0)
  path     String?
  icon     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}



// ========== 角色-权限关联表 ==========
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ========== 部门表 ==========
model Department {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  parentId    String?
  parent      Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children    Department[] @relation("DeptTree")
  leader      String?
  phone       String?
  email       String?
  sort        Int          @default(0)
  status      Int          @default(1)
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ========== 登录日志表 ==========
model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  loginAt   DateTime @default(now())
  success   Boolean  @default(true)
  message   String?
}

// ========== 操作日志表 ==========
model OperationLog {
  id        String   @id @default(uuid())
  userId    String
  username  String
  action    String
  module    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

// ========== 客户表 ==========
model Customer {
  id          String   @id @default(uuid())
  companyName String
  contactName String?
  englishName String?  // 英文名
  position    String?  // 职位
  email       String?
  phone       String?
  wechat      String?  // 微信
  country     String?
  region      String?  // 所在地区（省市区，如 "广东省·广州市"）
  customerLevel String? @default("普通客户") // 客户等级：钻石客户/战略客户/优质客户/普通客户/潜在客户
  source      String?  // MANUAL / EXCEL / XIAOMAN
  notes       String?

  // 归属（null = 公海）
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  // 重点客户标记
  isKeyAccount Boolean  @default(false)
  intentLevel  String?  // LOW / MEDIUM / HIGH / READY

  // 客户标签（逗号分隔，如 "VIP,长期合作,高利润"）
  tags         String?  @default("")

  // 首次下单日期（自动推算：取其下最早订单日期）
  firstOrderDate String?

  // 预计商机金额
  estimatedAmount Float?

  // 关联数据
  orders     Order[]
  pipelines  SalesPipeline[]
  activities CustomerActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 客户活动日志 ==========
model CustomerActivity {
  id         String   @id @default(uuid())
  customerId String
  action     String   // CLAIM / RELEASE / CREATED / UPDATED / KEY_TOGGLE / INTENT_CHANGE
  detail     String?
  createdBy  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ========== 订单表 ==========
model Order {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderNo      String?
  orderDate    String?
  amountCNY    Float?
  deliveryDate String?
  paymentTerms String?
  status       String?  // PENDING / CONFIRMED / IN_PRODUCTION / SHIPPED / DELIVERED
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ========== 销售管道 ==========
model SalesPipeline {
  id          String      @id @default(uuid())
  stage       String      @default("LEAD") // LEAD → OPPORTUNITY → SAMPLE → ORDER

  // 关联客户
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // 基础信息（各阶段通用）
  title       String
  companyName String
  contactName String?
  email       String?
  phone       String?
  country     String?

  // 线索阶段
  source          String?  // 来源: XIAOMAN / EXCEL / MANUAL
  productInterest String?  // 感兴趣的产品
  leadNotes       String?

  // 商机阶段
  estimatedAmount    Float?  // 预估金额(CNY)
  estimatedCloseDate String? // 预计成交日期
  probability        Int?    // 成交概率(%)
  opportunityNotes   String?

  // 样品阶段
  sampleType     String?   // 样品类型
  sampleQuantity Int?      // 样品数量
  sampleStatus   String?   // PENDING / SENT / CONFIRMED / FEEDBACK
  sampleNotes    String?

  // 订单阶段
  orderAmount       Float?   // 订单金额(CNY)
  orderDate         String?  // 下单日期
  deliveryDate      String?  // 交付日期
  paymentTerms      String?  // 付款条件
  orderStatus       String?  // PENDING / CONFIRMED / IN_PRODUCTION / SHIPPED / DELIVERED
  orderNotes        String?

  // 系统字段
  assignedTo String?
  assignee   User?       @relation(fields: [assignedTo], references: [id])
  activities SalesActivity[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ========== 销售活动日志 ==========
model SalesActivity {
  id         String   @id @default(uuid())
  pipelineId String
  action     String   // STAGE_CHANGE / NOTE_ADDED / CREATED / UPDATED
  fromStage  String?
  toStage    String?
  comment    String?
  createdBy  String
  createdAt  DateTime @default(now())

  pipeline SalesPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

// ========== 每日汇率表 ==========
model DailyExchangeRate {
  id           String   @id @default(uuid())
  date         String   // "YYYY-MM-DD"
  currencyCode String   // USD, EUR, GBP, JPY, etc.
  ratePerCNY   Float    // 1 CNY = 目标币种汇率
  createdAt    DateTime @default(now())

  @@unique([date, currencyCode], name: "daily_rate_unique")
}
