// ============================================================
// 08-sales-order.prisma — 正式销售订单
// Batch 5 物理拆分：内容逐字搬迁自原 server/prisma/schema.prisma，未做任何业务改动。
// ============================================================
// ========== 销售订单（04 §3 · 履约主载体，Order(type=ORDER) 拆分产出）==========
/// 无 deletedAt —— 履约单据只允许 CANCELLED，不允许删除（Q9 / ADR-08）。
model SalesOrder {
  id      String @id @default(cuid())
  orderNo String @unique // SO-yyyyMMdd-0001

  // ---------- 上游链接 ----------
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  /// 商业来源报价单（**可选**）：NULL 合法（老客复购 / 固定价 / 框架订单 / 无需正式报价）。
  /// Quotation 1:N SalesOrder，故**不加 @unique**。
  quotationId   String?
  quotation     Quotation?   @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// 来源打样单（Q10 / 第三批）：SampleOrder 1:N SalesOrder，故**不加 @unique**；无需打样时为 NULL。
  sampleOrderId String?
  sampleOrder   SampleOrder? @relation("OrderSourceSample", fields: [sampleOrderId], references: [id], onDelete: SetNull)

  // ---------- 履约状态机 ----------
  status            SalesOrderStatus @default(DRAFT)
  confirmedAt       DateTime?
  depositPaidAt     DateTime?
  productionStartAt DateTime?
  qcAt              DateTime?
  readyToShipAt     DateTime?
  shippedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?

  // ---------- 金额（三件套，全部 Decimal）----------
  currency       Currency @default(USD)
  exchangeRate   Decimal? @db.Decimal(18, 8) // 快照：1 原币 = x CNY（ADR-18）
  totalAmount    Decimal  @db.Decimal(18, 4)
  totalAmountCny Decimal? @db.Decimal(18, 4)
  depositRatio   Decimal? @db.Decimal(9, 4) // 定金比例 %（百分数语义）
  depositAmount  Decimal? @db.Decimal(18, 4)
  balanceAmount  Decimal? @db.Decimal(18, 4)
  /// 已收/已付累计（本位币），由 Payment(direction=IN, status=CONFIRMED) 汇总回写。
  paidAmountCny  Decimal  @default(0) @db.Decimal(18, 4)

  // ---------- 贸易与交期 ----------
  orderDate          DateTime?
  deliveryDate       DateTime?
  actualDeliveryDate DateTime?
  tradeTerms         String?
  paymentTerms       String?
  portOfLoading      String?
  portOfDischarge    String?

  // ---------- 快照（ADR-04）----------
  customerSnapshot Json?
  termsSnapshot    Json?

  // ---------- 归属 ----------
  ownerId String? // 业务跟单员
  owner   User?   @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // ---------- 下游（子表持 FK + 本侧反向，禁止子表再存重复 FK）----------
  items            SalesOrderItem[]
  productionOrders ProductionOrder[] // SalesOrder 1:N ProductionOrder
  shipments        Shipment[] // SalesOrder 1:N Shipment（分批发货）
  payments         Payment[] // SalesOrder 1:N Payment（收款侧宿主之一）
  purchaseOrders   PurchaseOrder[] // PurchaseOrder.salesOrderId 的反向（成本归集，04 §7）
  profit           Profit? // 1:1 —— Profit.salesOrderId @unique（一单一条，04 §9）
  // 注意：不声明 inspections QualityInspection[]（Q14：QC 宿主为生产单/出货单，订单经二者间接追溯）
  // 注意：不声明 approvalRecords ApprovalRecord[]（审批为多态旁挂，见 01 §4）

  remark    String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([opportunityId])
  @@index([ownerId])
  @@index([orderDate])
  @@index([deliveryDate])
}

/// 订单明细 —— 「快照不可变」原则的核心落点。
model SalesOrderItem {
  id      String     @id @default(cuid())
  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo  Int // 行号

  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// 下单时选用的客户定制版本（真实外键，onDelete SetNull）
  customerProductId String?
  customerProduct   CustomerProduct? @relation(fields: [customerProductId], references: [id], onDelete: SetNull)

  // ---------- 快照（下单时刻拷入，此后只读）----------
  productName String
  productSku  String?
  spec        String?
  craft       String?
  size        String?
  material    String?
  packaging   String?
  colors      String[]

  quantity   Decimal  @db.Decimal(18, 4)
  unit       String   @default("PCS")
  unitPrice  Decimal  @db.Decimal(18, 6)
  amount     Decimal  @db.Decimal(18, 4) // = quantity * unitPrice
  currency   Currency @default(USD)
  costPrice  Decimal? @db.Decimal(18, 6)
  costAmount Decimal? @db.Decimal(18, 4)

  deliveryDate DateTime?
  /// 已出货数量（由 ShipmentItem 汇总回写）
  shippedQty   Decimal   @default(0) @db.Decimal(18, 4)
  remark       String?
  sort         Int       @default(0)

  // ---------- 反向（成本归集链 / 出货链）----------
  productionItems ProductionOrderItem[] // ProductionOrderItem.salesOrderItemId 的反向
  shipmentItems   ShipmentItem[] // ShipmentItem.salesOrderItemId 的反向

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, lineNo])
  @@index([orderId])
  @@index([productId])
  @@index([customerProductId])
}
