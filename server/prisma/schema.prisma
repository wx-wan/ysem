generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========== 用户表 ==========
model User {
  id          String       @id @default(uuid())
  username    String       @unique
  password    String
  realName    String
  email       String?      @unique
  phone       String?
  avatar      String?
  status      String       @default("ACTIVE")
  departmentId String?
  department  Department?  @relation(fields: [departmentId], references: [id])
  roleId      String?
  role        Role?        @relation(fields: [roleId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastLoginAt DateTime?
  loginLogs   LoginLog[]
  createdBy   String?
  creator     User?        @relation("CreatedUsers", fields: [createdBy], references: [id])
  createdUsers User[]      @relation("CreatedUsers")
  refreshToken String?
  salesPipelines SalesPipeline[]
  customers      Customer[]
}



// ========== 角色表 ==========
model Role {
  id          String      @id @default(uuid())
  name        String      @unique
  code        String      @unique
  description String?
  status      Int         @default(1)
  sort        Int         @default(0)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ========== 权限表 ==========
model Permission {
  id       String           @id @default(uuid())
  name     String           @unique
  code     String           @unique
  type     String           @default("BUTTON")
  parentId String?
  parent   Permission?      @relation("PermissionTree", fields: [parentId], references: [id])
  children Permission[]     @relation("PermissionTree")
  roles    RolePermission[]
  sort     Int              @default(0)
  path     String?
  icon     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}



// ========== 角色-权限关联表 ==========
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ========== 部门表 ==========
model Department {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  parentId    String?
  parent      Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children    Department[] @relation("DeptTree")
  leader      String?
  phone       String?
  email       String?
  sort        Int          @default(0)
  status      Int          @default(1)
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ========== 登录日志表 ==========
model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  loginAt   DateTime @default(now())
  success   Boolean  @default(true)
  message   String?
}

// ========== 操作日志表 ==========
model OperationLog {
  id        String   @id @default(uuid())
  userId    String
  username  String
  action    String
  module    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

// ========== 客户表 ==========
model Customer {
  id          String   @id @default(uuid())
  customerCode String? @unique // 客户编号：CUS-YYMMDD-序号
  companyName String
  contactName String?
  englishName String?  // 英文名
  position    String?  // 职位
  email       String?
  phone       String?
  wechat      String?  // 微信
  country     String?
  region      String?  // 所在地区（省市区，如 "广东省·广州市"）
  customerLevel String? @default("普通客户") // 客户等级：钻石客户/战略客户/优质客户/普通客户/潜在客户
  source      String?  // MANUAL / EXCEL / XIAOMAN
  notes       String?

  // 归属（null = 公海）
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  // 重点客户标记
  isKeyAccount Boolean  @default(false)
  intentLevel  String?  // LOW / MEDIUM / HIGH / READY

  // 客户标签（逗号分隔，如 "VIP,长期合作,高利润"）
  tags         String?  @default("")

  // 首次下单日期（自动推算：取其下最早订单日期）
  firstOrderDate String?

  // 预计商机金额
  estimatedAmount Float?

  // 关联数据
  orders     Order[]
  pipelines  SalesPipeline[]
  activities CustomerActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 客户活动日志 ==========
model CustomerActivity {
  id         String   @id @default(uuid())
  customerId String
  action     String   // CLAIM / RELEASE / CREATED / UPDATED / KEY_TOGGLE / INTENT_CHANGE
  detail     String?
  createdBy  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ========== 订单表 ==========
// 订单阶段（统一流程，样品单融入订单）：
//   DEPOSIT(预付款) → SAMPLE_ORDER(下打样单) → DESIGN(设计) → MOLD(开模) → SAMPLE_SENT(寄样) → PRODUCTION(生产) → SHIPPED(出货)
model Order {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderNo      String?
  orderDate    String?
  amountCNY    Float?        // 订单金额（CNY）
  depositAmount Float?       // 预付款金额（CNY）
  depositPaid  Boolean? @default(false) // 预付款是否已付
  deliveryDate String?
  paymentTerms String?
  // 7 阶段流程
  status       String?  @default("DEPOSIT") // DEPOSIT / SAMPLE_ORDER / DESIGN / MOLD / SAMPLE_SENT / PRODUCTION / SHIPPED
  // 各阶段时间节点（用于进度跟踪，可选）
  sampleOrderDate String? // 下打样单日期
  designDate      String? // 设计完成日期
  moldDate        String? // 开模日期
  sampleSentDate  String? // 寄样日期
  productionStartDate String? // 生产开始日期
  shippedDate     String? // 出货日期
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ========== 销售管道 ==========
model SalesPipeline {
  id          String      @id @default(uuid())
  pipelineNumber String?  @unique // 商机编号：BO-YYYYMMDD-序号
  stage       String      @default("LEAD") // LEAD → OPPORTUNITY → ORDER

  // 关联客户
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // 基础信息（各阶段通用）
  title       String
  companyName String
  contactName String?
  email       String?
  phone       String?
  country     String?

  // 线索阶段
  source          String?  // 来源: XIAOMAN / EXCEL / MANUAL
  productInterest String?  // 感兴趣的产品
  leadNotes       String?

  // 商机阶段
  estimatedAmount    Float?  // 预估金额(CNY)
  estimatedCloseDate String? // 预计成交日期
  probability        String? // 采购意向：准成交 / 高意向 / 中意向 / 低意向（直接存储文案，不再存数字）
  opportunityNotes   String?

  // 订单阶段
  orderAmount       Float?   // 订单金额(CNY)
  orderDate         String?  // 下单日期
  deliveryDate      String?  // 交付日期
  paymentTerms      String?  // 付款条件
  orderStatus       String?  // 订单阶段已统一到 Order 模型（DEPOSIT/SAMPLE_ORDER/DESIGN/MOLD/SAMPLE_SENT/PRODUCTION/SHIPPED）
  orderNotes        String?

  // 样品单阶段信息（导入兼容）
  sampleType        String?
  sampleStatus      String?
  sampleQuantity    Int?
  sampleNotes       String?

  // 系统字段
  assignedTo String?
  assignee   User?       @relation(fields: [assignedTo], references: [id])
  activities SalesActivity[]
  leadProducts LeadProduct[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ========== 工艺 ==========
model ProductCraft {
  id        String   @id @default(uuid())
  name      String   @unique              // 搪胶 / 注塑 / 硅胶（基础工艺，可多选组合）
  code      String?  @unique              // 编码（如 TJ / ZS / GJ），用于自动生成 SKU
  sort      Int      @default(0)
  status    Int      @default(1)          // 1 启用 / 0 停用
  products  Product[]                    // 多对多：一个产品可挂多个工艺
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 二级受众 ==========
model ProductAudience {
  id         String   @id @default(uuid())
  name       String   @unique             // 儿童 / 宠物 / 配件 / 文具 / 家居
  code       String?  @unique             // 编码（如 ET / CW / PJ / WJ / JJ），用于自动生成 SKU
  sort       Int      @default(0)
  status     Int      @default(1)
  categories ProductCategory[]            // 关联三级品类
  products   Product[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ========== 三级产品品类 ==========
model ProductCategory {
  id        String   @id @default(uuid())
  name      String                        // 沐浴玩具 / 挤压玩具 / 存钱罐 ...
  audienceId String
  audience  ProductAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  sort      Int      @default(0)
  status    Int      @default(1)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([audienceId, name])
}

// ========== 产品 ==========
// 定制类产品核心模型：工艺 → 受众 → 品类 三级分类 + 产品属性 + 产品要求
model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String?  @unique

  // ---- 三级分类 ----
  crafts      ProductCraft[]                  // 多对多：工艺（可多选，如 搪胶+注塑）
  audienceId  String?
  audience    ProductAudience? @relation(fields: [audienceId], references: [id])
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])

  // ---- (定制)产品属性（必填）----
  images      String?                      // 产品图片 JSON 数组 [{url,name}]，第一张为主图
  sizeL       String?                      // 长 cm
  sizeW       String?                      // 宽 cm
  sizeH       String?                      // 高 cm
  weight      String?                      // 克重 g
  unit        String?                      // 产品单位（套/个）

  // ---- (深/轻)产品要求（打样单号）----
  sampleNo    String?                      // 打样单号
  logo        Boolean  @default(false)      // 功能：logo
  sound       Boolean  @default(false)      // 发声
  glow        Boolean  @default(false)      // 发光
  colorChange Boolean  @default(false)      // 变色
  sprayWater  Boolean  @default(false)      // 喷水
  colors      String?                      // 颜色（潘通色），逗号分隔
  packaging   String?                      // 产品包装（卡/盒/袋/桶）

  // ---- 供货定制模式（多选，由角色决定可选范围）----
  supplyModes String?  @default("")        // 逗号分隔：DEEP_CUSTOM/LIGHT_CUSTOM/STOCK

  // ---- 认证资质：关联现有证书，逗号分隔证书 id ----
  certificationIds String? @default("")   // 逗号分隔证书 id

  // ---- 产品进度（打样 / 报价 阶段多子任务并行）----
  // JSON 结构：{ stages: { sampling: SamplingStage[], quoting: QuotingStage[] } }
  // SamplingStage: { id, name, status('pending'|'active'|'done'), steps: { key, label, done }[] }
  progress   String?   @default("{}")

  // ---- 保留原有字段 ----
  spec        String?
  description String?
  price       Float?
  currency    String?  @default("CNY")
  taxRate     Float?  @default(13)
  stock       Int?    @default(0)
  lowStockAlert Int?  @default(0)
  source      String   @default("MANUAL")
  status      String   @default("ACTIVE")
  remark      String?

  leadProducts LeadProduct[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 线索-产品关联（一条线索可包含多个产品，带数量）
model LeadProduct {
  id        String   @id @default(cuid())
  leadId    String
  productId String
  quantity  Int      @default(1)
  pipeline  SalesPipeline @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([leadId, productId])
}

// ========== 销售活动日志 ==========
model SalesActivity {
  id         String   @id @default(uuid())
  pipelineId String
  action     String   // STAGE_CHANGE / NOTE_ADDED / CREATED / UPDATED
  fromStage  String?
  toStage    String?
  comment    String?
  createdBy  String
  createdAt  DateTime @default(now())

  pipeline SalesPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

// ========== 每日汇率表 ==========
model DailyExchangeRate {
  id           String   @id @default(uuid())
  date         String   // "YYYY-MM-DD"
  currencyCode String   // USD, EUR, GBP, JPY, etc.
  ratePerCNY   Float    // 1 CNY = 目标币种汇率
  createdAt    DateTime @default(now())

  @@unique([date, currencyCode], name: "daily_rate_unique")
}

// ========== 证书管理 ==========
model Certificate {
  id          String   @id @default(cuid())
  name        String   // 证书名称，如 CE 认证
  code        String?  // 证书编号 / 标准代号，如 CE / FCC
  issuer      String?  // 发证机构
  category    String?  // 分类，如 安全 / 电磁兼容 / 环保
  validUntil  DateTime? // 有效期至（可选）
  status      Int      @default(1) // 1 启用 0 停用
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

